let volumes = Resources.*[ Type == 'AWS::EC2::Volume' ]
let secrets = Resources.*[ Type == 'AWS::SecretsManager::Secret' ]
let ingress = Resources.*[ Type == 'AWS::EC2::SecurityGroupIngress' ]
let runtime_roles = Resources.*[ Type == 'AWS::IAM::Role' ]

rule retained_volume when %volumes !empty {
    %volumes {
        DeletionPolicy == 'Retain'
        UpdateReplacePolicy == 'Retain'
        Properties.Encrypted == true
    }
}

rule retained_secrets when %secrets !empty {
    %secrets {
        DeletionPolicy == 'Retain'
        UpdateReplacePolicy == 'Retain'
        Properties.SecretString !exists
    }
}

rule staged_startup when Parameters.Phase exists {
    Parameters.Phase.Default == 'foundation'
}

rule bounded_runtime_roles when %runtime_roles !empty {
    %runtime_roles.Properties {
        RoleName exists
        Path exists
        PermissionsBoundary exists
    }
}

rule no_public_ingress when %ingress !empty {
    %ingress.Properties {
        when CidrIp is_string {
            CidrIp != '0.0.0.0/0'
        }
        when CidrIp is_struct {
            CidrIp.Ref == 'OperatorCidr'
        }
        when CidrIpv6 exists {
            CidrIpv6 is_string
            CidrIpv6 != '::/0'
        }
    }
}
