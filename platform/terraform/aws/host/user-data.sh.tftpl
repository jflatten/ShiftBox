#!/bin/sh
set -eu

install -d -m 0755 /etc/ecs /usr/local/libexec

cat > /etc/ecs/ecs.config <<'AGENT'
ECS_CLUSTER=${cluster_name}
ECS_CONTAINER_INSTANCE_TAGS=${jsonencode({ cluster_name = cluster_name, project = "shiftbox" })}
ECS_AWSVPC_BLOCK_IMDS=true
ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true
AGENT

cat > /usr/local/libexec/shiftbox-mount-data <<'MOUNT_SCRIPT'
${mount_script}
MOUNT_SCRIPT
chmod 0755 /usr/local/libexec/shiftbox-mount-data

cat > /etc/systemd/system/shiftbox-data.service <<'DATA_UNIT'
[Unit]
Description=Mount the persistent ShiftBox data volume
After=cloud-final.service
Before=docker.service ecs.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/shiftbox-mount-data ${volume_serial} /var/lib/shiftbox-data ${initialize}
RemainAfterExit=yes
TimeoutStartSec=300
DATA_UNIT

for service in docker ecs; do
    install -d -m 0755 "/etc/systemd/system/$service.service.d"
    cat > "/etc/systemd/system/$service.service.d/shiftbox-data.conf" <<'DEPENDENCY'
[Unit]
Requires=shiftbox-data.service
After=shiftbox-data.service
DEPENDENCY
done

systemctl daemon-reload
systemctl enable --now --no-block ecs.service
