[Unit]
Description=Mount the dedicated ShiftBox registry cache volume
After=local-fs.target
Before=ecs.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/shiftbox-mount-registry-cache %i /var/lib/shiftbox-registry-cache false
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=ecs.service
