#!/bin/bash
set -euo pipefail

curl --fail --silent --show-error --retry 4 \
  https://pkgs.tailscale.com/stable/amazon-linux/2023/tailscale.repo \
  -o /etc/yum.repos.d/tailscale.repo
dnf install -y tailscale dnsmasq nftables

cat >/etc/sysctl.d/99-shiftbox-tailscale.conf <<'EOF'
net.ipv4.ip_forward = 1
EOF
sysctl -p /etc/sysctl.d/99-shiftbox-tailscale.conf

# Only ShiftBox browser traffic can traverse the advertised AWS subnet.
cat >/etc/shiftbox-tailscale.nft <<'EOF'
table inet shiftbox_tailscale {
  chain input {
    type filter hook input priority -10; policy accept;
    iifname "tailscale0" udp dport 53 accept
    iifname "tailscale0" tcp dport 53 accept
    iifname "tailscale0" drop
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    iifname "tailscale0" ip daddr ${subnet_cidr} tcp dport ${browser_port} accept
    iifname "tailscale0" drop
  }
}
EOF

cat >/etc/systemd/system/shiftbox-tailscale-firewall.service <<'EOF'
[Unit]
Description=Limit traffic from the ShiftBox tailnet

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/shiftbox-tailscale.nft
RemainAfterExit=yes
EOF

mkdir -p /etc/systemd/system/tailscaled.service.d
cat >/etc/systemd/system/tailscaled.service.d/firewall.conf <<'EOF'
[Unit]
Requires=shiftbox-tailscale-firewall.service
After=shiftbox-tailscale-firewall.service
EOF

# Route 53 resolves the private zone from the router's VPC. Limit DNS to tailnet clients.
cat >/etc/dnsmasq.conf <<'EOF'
interface=tailscale0
except-interface=lo
bind-dynamic
no-resolv
server=/${dns_suffix}/169.254.169.253
EOF

systemctl daemon-reload
systemctl enable --now tailscaled dnsmasq
